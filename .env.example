# contoh — salin ke .env
PORT=8080
APP_ENV=development
# Kosongkan untuk SQLite lokal (file bookings.db);
# isi postgres://... untuk PostgreSQL.
DATABASE_URL=
# Kosongkan untuk menonaktifkan auth (dev lokal);
# isi dengan string acak sebelum deploy publik.
# ADMIN_API_KEY cocok -> peran "admin" (akses penuh).
# USER_API_KEY cocok -> peran "user" (boleh baca + tambah; dilarang PUT/PATCH/DELETE).
# API_KEY legacy: bila ADMIN_API_KEY kosong, dipakai sebagai kunci admin.
API_KEY=
ADMIN_API_KEY=
USER_API_KEY=
