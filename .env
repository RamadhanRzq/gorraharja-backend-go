# ---------------------------------------------------------------------------
# GOR Sports Booking & Management System — API configuration
#
# Copy to `.env` and adjust. Every variable below is optional: the server falls
# back to the default shown when a variable is unset or empty.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | staging | production. `production` enables extra hardening.
APP_ENV=development
# HTTP listen port.
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# IANA timezone used for booking/availability date math.
APP_TIMEZONE=Asia/Jakarta

# --- Database --------------------------------------------------------------
# PostgreSQL connection string (only datastore used).
DATABASE_URL=postgres://spc:postgres@localhost:5432/gorraharja?sslmode=disable
# Maximum size of the pgx connection pool.
DB_MAX_CONNS=10
# Minimum idle connections kept warm.
DB_MIN_CONNS=1

# --- Authentication --------------------------------------------------------
# HMAC signing key for JWTs. MUST be a random string of at least 32 characters
# in production; never reuse this placeholder value.
JWT_SECRET=4f8c2a91e7b0d6359ac14f28de70b3a6c5192ef84d07b36a1c8e5f920d4a7b63
JWT_ISSUER=gorraharja-api
# Go duration syntax (e.g. 15m, 24h).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- Booking rules ---------------------------------------------------------
# Time a PENDING booking is held before the expiry sweep cancels it.
BOOKING_PAYMENT_DEADLINE=30m
# Minimum notice required to cancel before the slot starts (0 = no cutoff).
BOOKING_CANCELLATION_CUTOFF=0s
# How far ahead customers may book.
BOOKING_MAX_ADVANCE_DAYS=30
# Interval between background sweeps for expired PENDING bookings.
EXPIRY_SWEEP_INTERVAL=1m

# --- Bootstrapping ---------------------------------------------------------
# Apply embedded migrations on startup.
MIGRATE_ON_START=true
# Seed reference data (sports, facilities, admin) on startup.
SEED_ON_START=true
# Initial administrator created by the seeder.
ADMIN_EMAIL=admin@gorraharja.local
# Change this before enabling SEED_ON_START in production.
ADMIN_PASSWORD=Admin#12345
ADMIN_NAME=GOR Administrator

# --- HTTP / lifecycle ------------------------------------------------------
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173
# Graceful shutdown drain timeout.
SHUTDOWN_TIMEOUT=15s
